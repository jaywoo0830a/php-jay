    "description": "Symfony CommandTester 테스트",
    "body": [
      "#[Test]",
      "public function ${1:testCommand}(): void",
      "{",
      "    self::bootKernel();",
      "    \\$application = new Application(self::\\$kernel);",
      "",
      "    \\$command = \\$application->find('${2:app:command-name}');",
      "    \\$commandTester = new CommandTester(\\$command);",
      "    \\$commandTester->execute([",
      "        '${3:argument}' => '${4:value}',",
      "        '--${5:option}' => '${6:opt-value}',",
