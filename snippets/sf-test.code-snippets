  "tdd-test-assert": {
    "prefix": "tdd-assert",
    "description": "PHPUnit 주요 Assertion 모음",
    "body": [
      "// 기본 Assertions",
      "self::assertSame(${1:expected}, \\$${2:actual});",
      "self::assertEquals(${1:expected}, \\$${2:actual});",
      "self::assertTrue(\\$${3:condition});",
      "self::assertFalse(\\$${3:condition});",
      "self::assertNull(\\$${4:value});",
      "self::assertNotNull(\\$${4:value});",
      "self::assertEmpty(\\$${5:array});",
      "self::assertNotEmpty(\\$${5:array});",
      "self::assertCount(${6:expectedCount}, \\$${7:array});",
      "self::assertContains(\\$${8:needle}, \\$${9:haystack});",
      "self::assertArrayHasKey('${10:key}', \\$${11:array});",
      "",
      "// 문자열 Assertions",
      "self::assertStringContainsString('${12:needle}', \\$${13:haystack});",
      "self::assertStringStartsWith('${14:prefix}', \\$${15:string});",
      "self::assertMatchesRegularExpression('/${16:pattern}/', \\$${17:string});",
      "",
      "// 예외 Assertions",
      "self::expectException(${18:\\RuntimeException}::class);",
      "self::expectExceptionMessage('${19:에러 메시지}');",
      "self::expectExceptionCode(${20:0});"
    ]
  },

