{
  "named-args":     { "prefix": "narg",  "body": "${1:fn}(${2:param}: ${3:val}${4:, ${5:p2}: ${6:v2}})", "description": "Named arguments (PHP 8.0+)" },
  "union-type":     { "prefix": "utype", "body": "${1:string}|${2:int}|${3:null}", "description": "Union type (PHP 8.0+)" },
  "intersection":   { "prefix": "itype", "body": "${1:A}&${2:B}", "description": "Intersection type (PHP 8.1+)" },
  "dnf-type":       { "prefix": "dtype", "body": "(${1:A}&${2:B})|${3:null}", "description": "DNF type (PHP 8.2+)" },
  "nullsafe":       { "prefix": "nsafe", "body": "\\$${1:obj}?->${2:method}(${3})", "description": "Nullsafe ?-> (PHP 8.0+)" },
  "attribute":      { "prefix": "attr",  "body": "#[${1:Name}(${2})]", "description": "#[Attribute] (PHP 8.0+)" },
  "readonly-prop":  { "prefix": "rprop", "body": "public readonly ${1:string} \\$${2:prop};", "description": "readonly property (PHP 8.1+)" },
  "fcall":          { "prefix": "fcall", "body": "${1:fn}(...)", "description": "First-class callable (PHP 8.1+)" },
  "new-init":       { "prefix": "newi",  "body": ["public function __construct(", "    private ${1:Logger} \\$logger = new ${2:NullLogger}(),", ") {}"], "description": "new in initializers (PHP 8.1+)" },
  "array-is-list":  { "prefix": "aisl",  "body": "array_is_list(\\$${1:arr})", "description": "array_is_list() (PHP 8.1+)" },
  "array-find":     { "prefix": "afind", "body": ["array_find(\\$${1:arr}, fn (${2:mixed} \\$${3:item}) => ${4:cond});"], "description": "array_find() (PHP 8.4+)" },
  "array-any":      { "prefix": "aany",  "body": ["array_any(\\$${1:arr}, fn (${2:mixed} \\$${3:item}) => ${4:cond});"], "description": "array_any() (PHP 8.4+)" },
  "array-all":      { "prefix": "aall",  "body": ["array_all(\\$${1:arr}, fn (${2:mixed} \\$${3:item}) => ${4:cond});"], "description": "array_all() (PHP 8.4+)" },
  "prop-hook":      { "prefix": "phook", "body": ["public ${1:string} \\$${2:prop} {", "    get => \\$this->${3:backing};", "    set (${1:string} \\$v) { \\$this->${3:backing} = ${4:strtolower}(\\$v); }", "}"], "description": "Property hooks (PHP 8.4+)" },
  "prop-get":       { "prefix": "pget",  "body": ["public ${1:string} \\$${2:prop} {", "    get => ${3:// computed};", "}"], "description": "Property get hook (PHP 8.4+)" },
  "asym-vis":       { "prefix": "avis",  "body": "${1:public} private(set) ${2:string} \\$${3:prop};", "description": "Asymmetric visibility (PHP 8.4+)" },
  "new-chain":      { "prefix": "newc",  "body": "new ${1:Class}(${2})->${3:method}(${4})", "description": "new without () chain (PHP 8.4+)" },
  "deprecated-attr":{ "prefix": "depr",  "body": "#[Deprecated(message: '${1:Use newMethod()}')]", "description": "#[Deprecated] (PHP 8.4+)" },
  "override-attr":  { "prefix": "overr", "body": "#[Override]", "description": "#[Override] (PHP 8.3+)" },
  "sensitive-param":{ "prefix": "sparam","body": "#[\\SensitiveParameter]", "description": "#[SensitiveParameter] (PHP 8.2+)" },
  "json-validate":  { "prefix": "jval",  "body": "json_validate(\\$${1:json})", "description": "json_validate() (PHP 8.3+)" },
  "never-type":     { "prefix": "never", "body": ": never", "description": "never return type (PHP 8.1+)" },
  "typed-const":    { "prefix": "tconst","body": "${1:final} ${2:public} const ${3:string} ${4:NAME} = '${5:val}';", "description": "Typed constant (PHP 8.3+)" },
  "lazy-object":    { "prefix": "lazy",  "body": ["\\$init = static fn (${1:Class} \\$p): ${1:Class} => new ${1:Class}(${2});", "\\$obj = (new \\ReflectionClass(${1:Class}::class))->newLazyProxy(\\$init);"], "description": "Lazy object (PHP 8.4+)" },
  "fiber":          { "prefix": "fiber", "body": ["\\$fiber = new \\Fiber(function (): void {", "    \\$val = \\Fiber::suspend('${1:after}');", "    ${0}", "});", "\\$fiber->start();", "\\$fiber->resume('${2:resume}');"], "description": "Fiber (PHP 8.1+)" }
}
