  },
  "sf-is-granted-service": {
    "prefix": "sf-grants",
    "description": "$this->security->isGranted() in service",
    "body": ["use Symfony\\Bundle\\SecurityBundle\\Security;", "", "public function __construct(private Security \\$security) {}", "", "// in method:", "if (\\$this->security->isGranted('${1:ROLE_ADMIN}')) {", "    ${0}", "}"]
  },
  "sf-login-user": {
    "prefix": "sf-login",
    "description": "$security->login() programmatic login",
    "body": ["use Symfony\\Bundle\\SecurityBundle\\Security;", "", "public function ${1:action}(Security \\$security): Response", "{", "    \\$user = ${2:// get user};", "    \\$security->login(\\$user${3:, 'form_login'});", "", "    return \\$this->redirectToRoute('${4:homepage}');", "}"]
  },
  "sf-logout": {
    "prefix": "sf-logout",
    "description": "$security->logout() programmatic logout",
    "body": "\\$security->logout(${1:false});"
  },
  "sf-password-hash": {
    "prefix": "sf-hash",
    "description": "UserPasswordHasherInterface password hashing",
    "body": ["use Symfony\\Component\\PasswordHasher\\Hasher\\UserPasswordHasherInterface;", "", "public function ${1:register}(UserPasswordHasherInterface \\$hasher): Response", "{", "    \\$user = new User();", "    \\$hashed = \\$hasher->hashPassword(\\$user, \\$${2:plainPassword});", "    \\$user->setPassword(\\$hashed);", "    ${0}", "}"]
  },
  "sf-security-service": {
    "prefix": "sf-sec",
    "description": "Security service injection pattern",
    "body": ["use Symfony\\Bundle\\SecurityBundle\\Security;", "", "public function __construct(", "    private readonly Security \\$security,", ") {}"]
  },
  "sf-user-entity": {
    "prefix": "sf-user",
    "description": "User entity (implements UserInterface + PasswordAuthenticatedUserInterface)",
    "body": [
      "<?php", "", "namespace ${1:App\\Entity};", "",
      "use App\\Repository\\UserRepository;",
      "use Doctrine\\ORM\\Mapping as ORM;",
      "use Symfony\\Component\\Security\\Core\\User\\PasswordAuthenticatedUserInterface;",
      "use Symfony\\Component\\Security\\Core\\User\\UserInterface;",
      "",
      "#[ORM\\Entity(repositoryClass: UserRepository::class)]",
      "#[ORM\\UniqueConstraint(name: 'UNIQ_IDENTIFIER_EMAIL', fields: ['email'])]",
      "class User implements UserInterface, PasswordAuthenticatedUserInterface",
      "{",
      "    #[ORM\\Id, ORM\\GeneratedValue, ORM\\Column]",
      "    private ?int \\$id = null;",
      "",
      "    #[ORM\\Column(length: 180)]",
      "    private ?string \\$email = null;",
      "",
      "    /** @var list<string> */",
      "    #[ORM\\Column]",
      "    private array \\$roles = [];",
      "",
      "    #[ORM\\Column]",
      "    private ?string \\$password = null;",
      "",
      "    public function getUserIdentifier(): string { return (string) \\$this->email; }",
      "    public function getRoles(): array { return array_unique([...\\$this->roles, 'ROLE_USER']); }",
      "    public function getPassword(): ?string { return \\$this->password; }",
      "    ${0}",
      "}"
    ]
  }
}
