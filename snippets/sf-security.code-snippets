{
  "sf-voter": {
    "prefix": "sf-voter",
    "description": "Security Voter 클래스",
    "body": [
      "<?php", "", "namespace ${1:App\\Security\\Voter};", "",
      "use Symfony\\Component\\Security\\Core\\Authentication\\Token\\TokenInterface;",
      "use Symfony\\Component\\Security\\Core\\Authorization\\Voter\\Voter;",
      "use Symfony\\Bundle\\SecurityBundle\\Security;",
      "",
      "/** @extends Voter<string, mixed> */",
      "class ${2:MyVoter} extends Voter",
      "{",
      "    public const ${3:EDIT} = '${4:EDIT}';",
      "",
      "    public function __construct(private readonly Security \\$security) {}",
      "",
      "    protected function supports(string \\$attribute, mixed \\$subject): bool",
      "    {",
      "        return \\$subject instanceof ${5:App\\Entity\\User};",
      "    }",
      "",
      "    protected function voteOnAttribute(string \\$attribute, mixed \\$subject, TokenInterface \\$token): bool",
      "    {",
      "        \\$user = \\$token->getUser();",
      "        if (!\\$user instanceof ${5:App\\Entity\\User}) { return false; }",
      "",
      "        return match (\\$attribute) {",
      "            self::${3:EDIT} => \\$user === \\$subject || \\$this->security->isGranted('ROLE_ADMIN'),",
      "            default => throw new \\LogicException('Unknown: ' . \\$attribute),",
      "        };",
      "    }",
      "}"
    ]
  },
  "sf-is-granted-controller": {
    "prefix": "sf-grant",
    "description": "#[IsGranted] controller attribute",
    "body": ["#[IsGranted('${1:ROLE_ADMIN}'${2:, message: '${3:Access denied}'})]", "public function ${4:action}(): Response", "{", "    ${0}", "}"]
  },
  "sf-is-granted-class": {
    "prefix": "sf-grantc",
    "description": "#[IsGranted] on controller class",
    "body": ["#[IsGranted('${1:ROLE_ADMIN}')]", "class ${2:AdminController} extends AbstractController", "{", "    ${0}", "}"]
  },
  "sf-deny-access": {
    "prefix": "sf-deny",
    "description": "$this->denyAccessUnlessGranted()",
    "body": "\\$this->denyAccessUnlessGranted('${1:ROLE_ADMIN}'${2:, null, '${3:message}'});"
  },
  "sf-current-user": {
    "prefix": "sf-cuser",
    "description": "#[CurrentUser] controller argument",
    "body": "public function ${1:action}(#[CurrentUser] ${2:?User} \\$user): Response"
  },
  "sf-current-user-required": {
    "prefix": "sf-cuserr",
    "description": "#[CurrentUser] (non-nullable = 403 if not logged in)",
