{
  "arr-list": { "prefix": "arr", "body": "[${1:value}, ${0}]", "description": "배열 [value, ...]" },
  "arr-map":  { "prefix": "ark", "body": "['${1:key}' => ${2:value}, ${0}]", "description": "연관배열 [key=>value, ...]" },
  "arr-kv":   { "prefix": "kv",  "body": "'${1:key}' => ${2:value},", "description": "'key'=>value, (addon)" },
  "arr-va":   { "prefix": "va",  "body": "${1:value}, ", "description": "value, (addon)" }
}
