      "            throw new UnexpectedTypeException(\\$constraint, ${3:MyConstraint}::class);",
      "        }",
      "",
      "        if (null === \\$value || '' === \\$value) {",
      "            return;",
      "        }",
      "",
      "        ${4:// TODO: 유효성 검사 로직}",
      "",
      "        if (${5:/* 검증 실패 조건 */}) {",
      "            \\$this->context->buildViolation(\\$constraint->message)",
      "                ->setParameter('{{ value }}', \\$value)",
