  "sf-voter": {
    "prefix": "sf-voter",
    "description": "Security Voter 클래스",
    "body": [
      "<?php",
      "",
      "namespace ${1:App\\Security\\Voter};",
      "",
      "use App\\Entity\\${2:User};",
      "use Symfony\\Bundle\\SecurityBundle\\Security;",
      "use Symfony\\Component\\Security\\Core\\Authentication\\Token\\TokenInterface;",
      "use Symfony\\Component\\Security\\Core\\Authorization\\Voter\\Voter;",
      "",
      "/**",
      " * @extends Voter<string, mixed>",
      " */",
      "class ${3:MyVoter} extends Voter",
      "{",
      "    public const ${4:EDIT} = '${5:EDIT}';",
      "",
      "    public function __construct(",
      "        private readonly Security \\$security,",
      "    ) {",
      "    }",
      "",
      "    protected function supports(string \\$attribute, mixed \\$subject): bool",
      "    {",
      "        return in_array(\\$attribute, [self::${4:EDIT}])",
      "            && \\$subject instanceof ${2:User};",
      "    }",
      "",
      "    /**",
      "     * @param ${2:User} \\$subject",
      "     */",
      "    protected function voteOnAttribute(string \\$attribute, mixed \\$subject, TokenInterface \\$token): bool",
      "    {",
      "        /** @var ${2:User} \\$user */",
      "        \\$user = \\$token->getUser();",
      "",
      "        if (!\\$user instanceof ${2:User}) {",
      "            return false;",
      "        }",
      "",
      "        return match (\\$attribute) {",
      "            self::${4:EDIT} => \\$this->can${4:Edit}(\\$user, \\$subject),",
      "            default => throw new \\LogicException('Unknown attribute: ' . \\$attribute),",
      "        };",
      "    }",
      "",
      "    private function can${4:Edit}(${2:User} \\$user, ${2:User} \\$subject): bool",
      "    {",
      "        return \\$user === \\$subject || \\$this->security->isGranted('ROLE_ADMIN');",
      "    }",
      "}"
    ]
  },

