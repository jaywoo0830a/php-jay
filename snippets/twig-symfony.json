{
  "path":      { "prefix": "tw-path",   "body": "{{ path('${1:route}'${2:, {${3:k}: ${4:v}}}) }}", "description": "{{ path() }}" },
  "url":       { "prefix": "tw-url",    "body": "{{ url('${1:route}'${2:, {${3:k}: ${4:v}}}) }}", "description": "{{ url() }}" },
  "asset":     { "prefix": "tw-asset",  "body": "{{ asset('${1:path}') }}", "description": "{{ asset() }}" },
  "absurl":    { "prefix": "tw-absurl", "body": "{{ absolute_url('${1:path}') }}", "description": "{{ absolute_url() }}" },
  "app-user":  { "prefix": "tw-user",   "body": ["{% if app.user %}", "    <p>{{ app.user.userIdentifier }}</p>", "{% endif %}"], "description": "app.user" },
  "app-env":   { "prefix": "tw-env",    "body": ["{% if app.debug %}", "    <p>{{ app.environment }}</p>", "{% endif %}"], "description": "app.debug/env" },
  "app-route": { "prefix": "tw-route",  "body": "{{ app.current_route }}", "description": "app.current_route" },
  "flash":     { "prefix": "tw-flash",  "body": ["{% for label, msgs in app.flashes %}", "    {% for msg in msgs %}", "        <div class=\"alert alert-{{ label }}\">{{ msg }}</div>", "    {% endfor %}", "{% endfor %}"], "description": "Flash messages (Bootstrap)" },
  "grant":     { "prefix": "tw-grant",  "body": ["{% if is_granted('${1:ROLE_ADMIN}') %}", "    ${0}", "{% endif %}"], "description": "is_granted()" },
  "csrf":      { "prefix": "tw-csrf",   "body": "<input type=\"hidden\" name=\"_csrf_token\" value=\"{{ csrf_token('${1:intention}') }}\">", "description": "CSRF token" },
  "render":    { "prefix": "tw-render", "body": "{{ render(controller('${1:App\\\\\\\\Controller\\\\\\\\MyController::method}'${2:, {${3:k}: ${4:v}}})) }}", "description": "{{ render(controller()) }}" },
  "render-route":{ "prefix": "tw-renderr","body": "{{ render(path('${1:route}'${2:, {${3:k}: ${4:v}}})) }}", "description": "{{ render(path()) }}" },
  "dump":      { "prefix": "tw-dump",   "body": "{{ dump(${1:var}) }}", "description": "{{ dump() }}" },
  "trans":     { "prefix": "tw-trans",  "body": ["{% trans %}", "    ${1:text}", "{% endtrans %}"], "description": "{% trans %}" },
  "trans-var": { "prefix": "tw-transv", "body": "{{ '${1:key}'|trans${2:([\\'%${3:p}%\\' => ${4:v}])} }}", "description": "|trans" },
  "form-start":{ "prefix": "tw-fstart", "body": "{{ form_start(${1:form}${2:, {attr: {class: '${3:my-form}'}}}) }}", "description": "form_start()" },
  "form-end":  { "prefix": "tw-fend",   "body": "{{ form_end(${1:form}) }}", "description": "form_end()" },
  "form-row":  { "prefix": "tw-frow",   "body": "{{ form_row(${1:form}.${2:field}${3:, {label: '${4:Label}'}}) }}", "description": "form_row()" },
  "form-widget":{ "prefix": "tw-fwidget","body": "{{ form_widget(${1:form}.${2:field}${3:, {attr: {class: '${4:form-control}'}}}) }}", "description": "form_widget()" },
  "form-label":{ "prefix": "tw-flabel", "body": "{{ form_label(${1:form}.${2:field}, '${3:Label}') }}", "description": "form_label()" },
  "form-errors":{ "prefix": "tw-ferrors","body": "{{ form_errors(${1:form}.${2:field}) }}", "description": "form_errors()" },
  "form-rest": { "prefix": "tw-frest",  "body": "{{ form_rest(${1:form}) }}", "description": "form_rest()" },
  "html5":     { "prefix": "tw-html5",  "body": ["<!DOCTYPE html>", "<html lang=\"${1:ko}\">", "<head>", "    <meta charset=\"UTF-8\">", "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">", "    <title>{% block title %}${2:My App}{% endblock %}</title>", "    <link rel=\"icon\" href=\"{{ asset('favicon.ico') }}\">", "    {% block stylesheets %}<link rel=\"stylesheet\" href=\"{{ asset('styles/app.css') }}\">{% endblock %}", "    {% block javascripts_head %}{% endblock %}", "</head>", "<body>", "    {% block header %}<header><nav></nav></header>{% endblock %}", "    {% block body %}<main>{% block content %}{% endblock %}</main>{% endblock %}", "    {% block footer %}<footer>&copy; {{ 'now'|date('Y') }}</footer>{% endblock %}", "    {% block javascripts %}<script src=\"{{ asset('js/app.js') }}\"></script>{% endblock %}", "</body>", "</html>"], "description": "HTML5 base.html.twig" },
  "page":      { "prefix": "tw-page",   "body": ["{% extends '${1:base.html.twig}' %}", "", "{% block title %}${2:Title}{% endblock %}", "", "{% block content %}", "    ${0}", "{% endblock %}"], "description": "extends + block page" },
  "turbo":     { "prefix": "tw-turbo",  "body": ["<turbo-frame id=\"${1:id}\">", "    ${0}", "</turbo-frame>"], "description": "Turbo Frame" },
  "stimulus":  { "prefix": "tw-stimulus","body": ["<div {{ stimulus_controller('${1:name}'${2:, {${3:k}: '${4:v}'}}) }}>", "    ${0}", "</div>"], "description": "Stimulus controller" }
}
